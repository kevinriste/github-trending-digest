# github-trending-digest environment. Copy to .env (gitignored) and fill in:
#   cp .env.example .env && chmod 600 .env
#
# process-caller.sh loads .env first, so the systemd timer needs no shell profile.
# Two keys can come from elsewhere; they are listed here so everything the code reads is
# documented in one place:
#   - GEMINI_API_KEY is also supplied by the systemd drop-in's EnvironmentFile
#     (github-trending-digest.service.d/*.conf); either source works.
#   - OPENAI_API_KEY is loaded by process.sh from a shared key file, which overrides a
#     value set here.

# --- Email delivery (Gmail SMTP) --------------------------------------------
# Account that sends the daily digest email, and its Google app password
# (https://myaccount.google.com/apppasswords). If unset, the run still publishes pages
# but logs "Gmail credentials not set" and sends no email.
GMAIL_PODCAST_ACCOUNT=sender@example.com
GMAIL_PODCAST_ACCOUNT_APP_PASSWORD=your-16-char-app-password
# Recipient of the digest email (defaults to a hardcoded address in trending_digest.py).
#DIGEST_EMAIL_TO=you@example.com

# --- Gotify (push alerts) ---------------------------------------------------
# Used by trending_digest.py for notices and by process-caller.sh to report a failed run.
# Without them, failures are only visible in the log.
GOTIFY_SERVER=https://gotify.example.com
GOTIFY_TOKEN=your-gotify-app-token

# --- LLM keys ---------------------------------------------------------------
# Gemini: summaries and the Morning Edition. Required (read as os.environ[...], so a
# missing key raises KeyError).
GEMINI_API_KEY=your-gemini-api-key
# OpenAI: HN comment camps analysis and the HN Take. If unset, those sections are skipped.
OPENAI_API_KEY=your-openai-api-key

# --- Models and tuning (all optional; defaults shown) -------------------------
# Model for the HN comment camps analysis (process.sh pins its own default).
#COMMENT_BRIEFING_MODEL=gpt-5-mini
# HN Take: on/off, model and reasoning effort, and selection limits.
#HN_TAKE_ENABLED=1
#HN_TAKE_MODEL=gpt-6-sol
#HN_TAKE_REASONING=medium
#HN_TAKE_MAX_STORIES=10
#HN_TAKE_MIN_CHARS=1500
#HN_TAKE_BODY_CAP=12000
#HN_TAKE_MAP_MIN_OVERLAP=8
#HN_TAKE_MAP_MIN_RATIO=1.5

# --- Services (optional; defaults point at local containers) ------------------
# Postgres for edition history (docker compose runs the postgres service).
# Default matches the compose postgres service (port 5433); override for another database.
#DATABASE_URL=postgresql://trending_digest:password@localhost:5433/trending_digest
# Local article scrapers used to fetch linked pages.
#LOCAL_FETCHER_URL=http://localhost:3001/fetch
#NYTIMES_FETCHER_URL=http://localhost:3002/fetch
